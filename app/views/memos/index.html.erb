<div class="col-md-8 mx-auto">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold">勉強メモ一覧</h1>
    <%= link_to "新しいメモを作成", new_memo_path, class: "btn btn-primary" %>
  </div>

  <% @memos.each do |memo| %>
    <div class="card mb-3 shadow-sm">
      <div class="card-body">
        <h2 class="h5 card-title">
          <%= link_to memo.title, memo, class: "text-decoration-none" %>
        </h2>
        <p class="card-text text-muted small mb-1">カテゴリ：<%= memo.category %></p>
        <p class="card-text text-muted small">勉強した日：<%= memo.studied_at %></p>
      </div>
    </div>
  <% end %>
</div>