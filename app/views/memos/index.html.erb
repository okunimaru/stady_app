<div class="max-w-3xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold">勉強メモ一覧</h1>
    <%= link_to "新しいメモを作成", new_memo_path, class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600" %>
  </div>

  <% @memos.each do |memo| %>
    <div class="border rounded p-4 mb-4 shadow-sm">
      <h2 class="text-xl font-semibold"><%= link_to memo.title, memo, class: "text-blue-600 hover:underline" %></h2>
      <p class="text-sm text-gray-500">カテゴリ：<%= memo.category %></p>
      <p class="text-sm text-gray-500">勉強した日：<%= memo.studied_at %></p>
    </div>
  <% end %>
</div>