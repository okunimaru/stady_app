<div class="col-md-8 mx-auto">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold">📚 勉強メモ一覧</h1>
    <%= link_to "＋ 新しいメモを作成", new_memo_path, class: "btn btn-primary rounded-pill px-4" %>
  </div>

  <div class="bg-white rounded-4 shadow p-4">
    <% @memos.each do |memo| %>
      <div class="card mb-3 border-0 shadow-sm" style="border-left: 4px solid #4e9af1 !important; background-color: #f0f7ff;">
        <div class="card-body">
          <h2 class="h5 card-title mb-1">
            <%= link_to memo.title.presence || "（タイトルなし）", memo, class: "text-decoration-none fw-bold text-primary" %>
          </h2>
          <p class="card-text text-muted small mb-1">
            🗂 カテゴリ：<%= memo.category.presence || "―" %>
          </p>
          <p class="card-text text-muted small mb-0">
            📅 勉強した日：<%= memo.studied_at.presence || "―" %>
          </p>
        </div>
      </div>
    <% end %>
  </div>
</div>