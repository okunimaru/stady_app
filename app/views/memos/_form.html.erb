<%= form_with(model: memo) do |form| %>
  <% if memo.errors.any? %>
    <div class="bg-red-100 text-red-700 p-4 rounded">
      <% memo.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "タイトル", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :title, class: "mt-1 block w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
  </div>

    <div>
    <%= form.label :source, "参考元", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :source, class: "mt-1 block w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
  </div>

  <div>
    <%= form.label :category, "カテゴリ", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_field :category, class: "mt-1 block w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
  </div>

  <div>
    <%= form.label :studied_at, "勉強した日", class: "block text-sm font-medium text-gray-700" %>
    <%= form.date_field :studied_at, class: "mt-1 block w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
  </div>

  <div>
    <%= form.label :content, "メモ内容", class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :content, rows: 6, class: "mt-1 block w-full border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
  </div>

  <%= form.submit class: "bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600 cursor-pointer" %>
<% end %>