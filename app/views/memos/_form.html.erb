<%= form_with(model: memo) do |form| %>
  <% if memo.errors.any? %>
    <div class="alert alert-danger">
      <% memo.errors.full_messages.each do |message| %>
        <p class="mb-0"><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, "タイトル", class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :source, "参考元", class: "form-label" %>
    <%= form.text_field :source, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :category, "カテゴリ", class: "form-label" %>
    <%= form.text_field :category, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :studied_at, "勉強した日", class: "form-label" %>
    <%= form.date_field :studied_at, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :content, "メモ内容", class: "form-label" %>
    <%= form.text_area :content, rows: 6, class: "form-control" %>
  </div>

  <%= form.submit class: "btn btn-primary" %>
<% end %>